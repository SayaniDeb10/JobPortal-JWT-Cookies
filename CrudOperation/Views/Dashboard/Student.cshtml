@using CrudOperation.Dto
@model List<JobDto>
@{
    ViewData["Title"] = "Student Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Student Dashboard</h2>
            <p class="text-muted">Find and apply for jobs</p>
        </div>

        <div>
            <a asp-controller="Student"
               asp-action="Profile"
               class="btn btn-outline-primary">
                My Profile
            </a>

            <a asp-controller="Auth"
               asp-action="Logout"
               class="btn btn-danger">
                Logout
            </a>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">

                <div class="col-md-4">
                    <input type="text"
                           class="form-control"
                           placeholder="Search Job Title">
                </div>

                <div class="col-md-3">
                    <input type="text"
                           class="form-control"
                           placeholder="Location">
                </div>

                <div class="col-md-3">
                    <input type="text"
                           class="form-control"
                           placeholder="Qualification">
                </div>

                <div class="col-md-2">
                    <button class="btn btn-primary w-100">
                        Search
                    </button>
                </div>

            </div>
        </div>
    </div>

    <h4 class="mb-3">Available Jobs</h4>
    @if (Model != null && Model.Count > 0){
        foreach(var app in Model){
    <div class="card shadow-sm mb-3">
        <div class="card-body">

            <h5>@app.JobTitle</h5>
            <h6 class="text-muted">@app.CompanyName</h6>

            <p>
                <strong>Location:</strong> @app.Location
            </p>

            <p>
                <strong>Salary:</strong> ₹@app.Salary LPA
            </p>

            <div class="text-end">
                <a href="#" class="btn btn-outline-primary">
                    View Details
                </a>

                <a href="#" class="btn btn-success">
                    Apply Now
                </a>
            </div>

        </div>
    </div>
}
    }
    else
    {
        <div class="alert alert-info">
            No jobs available.
        </div>
    }
</div>


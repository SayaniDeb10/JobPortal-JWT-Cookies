@using CrudOperation.Dto
@model List<JobDto>
@{
    ViewData["Title"] = "Recruiter Dashboard";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2>Recruiter Dashboard</h2>
            <p class="text-muted">Manage jobs and applicants</p>
        </div>

        <div>
            <a href="@Url.Action("NewJobForm","Dashboard")"
               class="btn btn-primary">
                Post New Job
            </a>

            <a asp-controller="Auth"
               asp-action="Logout"
               class="btn btn-danger">
                Logout
            </a>
        </div>

    </div>

    <div class="row mb-4">

        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h3>@Model.Count</h3>
                    <p class="mb-0">Jobs Posted</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h3>35</h3>
                    <p class="mb-0">Applications</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h3>8</h3>
                    <p class="mb-0">Active Jobs</p>
                </div>
            </div>
        </div>

    </div>

    <div class="card shadow-sm">

        <div class="card-header">
            <h5 class="mb-0">My Jobs</h5>
        </div>

        <div class="card-body">

            <table class="table table-bordered">

                <thead>
                    <tr>
                        <th>Job Title</th>
                        <th>Location</th>
                        <th>Salary</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Count > 0)
                    {
                        foreach(var job in Model)
                        {
                        <tr>
                            <td>@job.JobTitle</td>
                            <td>@job.Location</td>
                            <td>₹@job.Salary LPA</td>
                            <td>
                                <a asp-action="EditJob" asp-route-jobId="@job.Id" class="btn btn-sm btn-warning">
                                    Edit
                                </a>

                                <a asp-action="JobApplicants" asp-route-jobAppId="@job.Id" class="btn btn-sm btn-info">
                                    Applicants
                                </a>

                                <a asp-controller="Dashboard" asp-action="DeleteJob" asp-route-jobsId="@job.Id" class="btn btn-sm btn-danger">
                                    Delete
                                </a>
                            </td>
                        </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">Data Not Available</td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>


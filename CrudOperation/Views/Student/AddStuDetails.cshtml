@using CrudOperation.Dto
@model StudentDto
<style>
    body {
        background-color: #f4f6f9;
    }

    .card {
        border-radius: 15px;
    }

    .card-header {
        border-radius: 15px 15px 0 0 !important;
    }

    .form-control,
    .form-select {
        border-radius: 10px;
    }

    .btn {
        border-radius: 10px;
    }
</style>
<form asp-action="CreateUser" method="post">
    <div class="container mt-5">
        <div class="row justify-content-center">
            <div class="col-md-8">

                <div class="card shadow-lg border-0">

                    <div class="card-header bg-primary text-white py-3">
                        <div class="d-flex justify-content-between align-items-center">

                            <div>
                                <h3 class="mb-0">
                                    <i class="bi bi-person-plus-fill me-2"></i>
                                    Student Details
                                </h3>
                                <small>Please fill in all required fields.</small>
                            </div>

                            <a asp-action="Login" class="btn btn-light btn-sm">
                                <i class="bi bi-arrow-left"></i>
                                Back
                            </a>

                        </div>
                    </div>

                    <div class="card-body p-4">

                        <!-- Student Name -->
                        <div class="mb-3">
                            <label asp-for="StudentName" class="form-label">
                                Student Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="StudentName"
                                   class="form-control"
                                   placeholder="Enter Student Name"
                                   required />
                            <span asp-validation-for="StudentName" class="text-danger"></span>
                        </div>

                        <!-- Gender -->
                        <div class="mb-3">
                            <label class="form-label">
                                Gender <span class="text-danger">*</span>
                            </label>

                            <div>
                                <div class="form-check form-check-inline">
                                    <input asp-for="Gender"
                                           class="form-check-input"
                                           type="radio"
                                           value="Male"
                                           required />
                                    <label class="form-check-label">Male</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input asp-for="Gender"
                                           class="form-check-input"
                                           type="radio"
                                           value="Female" />
                                    <label class="form-check-label">Female</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input asp-for="Gender"
                                           class="form-check-input"
                                           type="radio"
                                           value="Other" />
                                    <label class="form-check-label">Other</label>
                                </div>
                            </div>

                            <span asp-validation-for="Gender" class="text-danger"></span>
                        </div>

                        <!-- Date of Birth -->
                        <div class="mb-3">
                            <label asp-for="DateOfBirth" class="form-label">
                                Date Of Birth <span class="text-danger">*</span>
                            </label>

                            <input asp-for="DateOfBirth"
                                   type="date"
                                   class="form-control"
                                   required />

                            <span asp-validation-for="DateOfBirth" class="text-danger"></span>
                        </div>

                        <!-- Age -->
                        <div class="mb-3">
                            <label asp-for="Age" class="form-label">
                                Age <span class="text-danger">*</span>
                            </label>

                            <input asp-for="Age"
                                   type="number"
                                   class="form-control"
                                   min="1"
                                   placeholder="Enter Age"
                                   required />

                            <span asp-validation-for="Age" class="text-danger"></span>
                        </div>

                        <!-- Qualification -->
                        <div class="mb-3">
                            <label asp-for="Qualifiaction" class="form-label">
                                Qualification <span class="text-danger">*</span>
                            </label>

                            <select asp-for="Qualifiaction"
                                    class="form-select"
                                    required>
                                <option value="">-- Select Qualification --</option>
                                <option>Secondary</option>
                                <option>Higher Secondary</option>
                                <option>Diploma</option>
                                <option>Graduate</option>
                                <option>Post Graduate</option>
                            </select>

                            <span asp-validation-for="Qualifiaction" class="text-danger"></span>
                        </div>

                        <!-- Language -->
                        <div class="mb-3">
                            <label class="form-label">
                                Language <span class="text-danger">*</span>
                            </label>

                            <div>
                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="Language"
                                           value="English" />
                                    <label class="form-check-label">English</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="Language"
                                           value="Hindi" />
                                    <label class="form-check-label">Hindi</label>
                                </div>

                                <div class="form-check form-check-inline">
                                    <input class="form-check-input"
                                           type="checkbox"
                                           name="Language"
                                           value="Bengali" />
                                    <label class="form-check-label">Bengali</label>
                                </div>
                            </div>
                        </div>

                        <!-- Location -->
                        <div class="mb-4">
                            <label asp-for="Location" class="form-label">
                                Location <span class="text-danger">*</span>
                            </label>

                            <textarea asp-for="Location"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Enter Location"
                                      required></textarea>

                            <span asp-validation-for="Location" class="text-danger"></span>
                        </div>

                        <!-- Buttons -->
                        <div class="mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                <i class="bi bi-check-circle-fill me-2"></i>
                                Submit
                            </button>
                        </div>

                    </div>
                </div>

            </div>
        </div>
    </div>
</form>